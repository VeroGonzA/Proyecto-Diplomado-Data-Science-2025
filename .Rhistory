pred2_opt <- ifelse(prob2 > opt2, 1, 0)
# Clasificación usando los umbrales óptimos
pred2_opt <- ifelse(prob2 > opt2, 1, 0)
pred4_opt <- ifelse(prob4 > opt5, 1, 0)

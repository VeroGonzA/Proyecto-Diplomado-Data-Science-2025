bbdd_b<-bbdd |>
select(c(ends_with("_mean")))
View(bbdd_b)
head(bbdd_b)
str(bbdd_b)
PerformanceAnalytics::chart.Correlation(bbdd_b, hist = T, pch ="+")
## Cálculo de las componentes principales:
PCA <- prcomp(bbdd_b, scale = TRUE) #scale=TRUE estandariza las vari
library(factoextra) #Librería factoextra es muy útil para gráficos

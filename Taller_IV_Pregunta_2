#### Pregunta 3: Variograma Clásico ####

# Calcular distancia máxima
# La recomendación es que no sea max que la distancia max medios
(hmax=max(dist(geo_bbdd$coords))) #distancia maxima 1138.1

# Calcular variograma empírico
vario_emp <- variog(geo_bbdd, max.dist = hmax / 2)
plot(vario_emp, main="Clasico con tendencia constante")

# Estimar parámetros
nugget <- vario_emp$v[1]
sill <- vario_emp$v[length(vario_emp$v)]
ind <- which(vario_emp$v >= 0.95 * sill)[1]
rangeH <- if (!is.na(ind)) vario_emp$u[ind] else vario_emp$u[length(vario_emp$u)]

# Graficar en el variograma
plot(vario_emp, main = "Variograma Clásico con tendencia cte de mg020 con parámetros estimados", pch = 20)
abline(h = nugget, col = "darkgreen", lty = 1)
abline(h = sill, col = "red", lty = 1)
abline(v = rangeH, col = "blue", lty = 1)
legend("bottomright",
       legend = c(paste0("Nugget = ", round(nugget, 2)),
                  paste0("Sill = ", round(sill, 2)),
                  paste0("Range = ", round(rangeH, 2))),
       col = c("darkgreen", "red", "blue"), lty = 1, bty = "n")



#### Pregunta 4: Ajuste de modelos por máxima verosimilitud #### 

#Parametros iniciales
nugget_ini <- 21.86
sill_total <- 45.52
sill_parcial <- sill_total - nugget_ini
range_ini <- 415.84

# Ajustar modelos con tendencia constante

fit_exp_cte <- likfit(geo_bbdd, trend = "cte", 
                      cov.model = "exponential",
                      ini.cov.pars = c(sill_parcial, range_ini), 
                      nugget = nugget_ini)

fit_mat_cte <- likfit(geo_bbdd, trend = "cte", 
                      cov.model = "matern", kappa = 1.5,
                      ini.cov.pars = c(sill_parcial, range_ini), 
                      nugget = nugget_ini)

fit_nug_cte <- likfit(geo_bbdd, trend = "cte",
                      cov.model = "pure.nugget",
                      ini.cov.pars = c(var(geo_bbdd$data), 0))

# Ajustar modelos con tendencia lineal
fit_exp_lin <- likfit(geo_bbdd, trend = "1st", 
                      cov.model = "exponential",
                      ini.cov.pars = c(sill_parcial, range_ini), 
                      nugget = nugget_ini)


fit_mat_lin <- likfit(geo_bbdd, trend = "1st", 
                      cov.model = "matern", kappa = 1.5,
                      ini.cov.pars = c(sill_parcial, range_ini), 
                      nugget = nugget_ini)

fit_nug_lin <- likfit(geo_bbdd, trend = "1st",
                      cov.model = "pure.nugget",
                      ini.cov.pars = c(var(geo_bbdd$data), 0))
# AIC
aic_table <- data.frame(
  Modelo = c("Exponencial", "Matern", "Exponencial", "Matern", "No espacial", "No espacial"),
  Tendencia = c("Constante", "Constante", "Lineal", "Lineal", "Constante", "Lineal"),
  AIC = c(AIC(fit_exp_cte), AIC(fit_mat_cte),
          AIC(fit_exp_lin), AIC(fit_mat_lin),
          AIC(fit_nug_cte), AIC(fit_nug_lin))
)

# Resumen AIC
aic_table <- aic_table[order(aic_table$AIC), ]
print(aic_table)


# Graficar variograma empírico con modelos ajustados
vario_emp <- variog(geo_bbdd)
plot(vario_emp, main = "Variograma empírico y modelos ajustados", pch = 20)
lines(fit_exp_cte, col = "blue")
lines(fit_mat_cte, col = "red")
lines(fit_nug_cte, col = "green")
legend("bottomright", legend = c("Exponencial", "Matern", "No espacial"),
       col = c("blue", "red", "green"), lty = 1, bty = "n")


#### Pregunta 5: KRIGING #####

# Definir una malla de predicción
pred_grid <- expand.grid(
  east = seq(min(bbdd$east), max(bbdd$east), length.out = 60),
  north = seq(min(bbdd$north), max(bbdd$north), length.out = 60)
)

# Realizar kriging ordinario
kriging_result <- krige.conv(geo_bbdd,
                             locations = pred_grid,
                             krige = krige.control(
                               type.krige = "ok",
                               trend.d = "cte",
                               trend.l = "cte",
                               cov.model = "exponential",
                               cov.pars = c(sill_parcial, range_ini),
                               nugget = nugget_ini
                             ))

# Graficar predicción del kriging

par(mfrow=c(1,2))
image(kriging_result, main = "Predicción por Kriging", 
      col = terrain.colors(50),
      xlab = "East", ylab = "North",
      nlevels = 16)
points(geo_bbdd$coords, pch = 20, cex = 0.6)

# Graficar varianza del kriging
image(kriging_result, val = kriging_result$krige.var,
      main = "Varianza del Kriging", 
      col = heat.colors(50),
      xlab = "East", ylab = "North")
points(geo_bbdd$coords, pch = 20, cex = 0.6)


